# =============================================================================
# WorkMind — .gitignore
# CONFIDENTIAL - PRIVATE REPOSITORY - NOT FOR PUBLIC DISTRIBUTION
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets — NEVER commit these
.env
*.env.local
*.env.production
secrets/
*.key
*.pem
*.token

# WorkMind runtime data — generated, not versioned
logs/
reports/
backups/
snapshots/
data/
version.json

# IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.pytype/

# Docker
.docker/
