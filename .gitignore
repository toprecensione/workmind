# =============================================================================
# WorkMind — .gitignore
# CONFIDENTIAL - PRIVATE REPOSITORY - NOT FOR PUBLIC DISTRIBUTION
# =============================================================================

# ── Secrets & Environment ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/

# ── Runtime data (mai committare dati dei clienti) ───────────────────────────
data/
logs/
backups/
reports/
snapshots/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── KeePass ──────────────────────────────────────────────────────────────────
*.kdbx
*.kdb

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Certificati SSL locali ───────────────────────────────────────────────────
ssl/
certs/
*.crt
*.cer

# ── Claude Code internal ─────────────────────────────────────────────────────
.claude/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets — NEVER commit these
.env
*.env.local
*.env.production
secrets/
*.key
*.pem
*.token

# WorkMind runtime data — generated, not versioned
logs/
reports/
backups/
snapshots/
data/
version.json

# IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.pytype/

# Docker
.docker/
