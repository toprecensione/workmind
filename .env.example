# =============================================================================
# WorkMind — Environment Configuration Template
# CONFIDENTIAL - PRIVATE REPOSITORY - NOT FOR PUBLIC DISTRIBUTION
#
# Copia questo file come .env e inserisci i valori reali.
# NEVER commit .env to version control.
# =============================================================================

# ── Node Identity ─────────────────────────────────────────────────────────────
WORKMIND_NODE_ID=node-001
WORKMIND_NODE_LABEL=Worker Node 1
WORKMIND_ENV=production

# ── GitHub / Auto-Update ──────────────────────────────────────────────────────
WORKMIND_REPO_URL=https://github.com/YOUR_ORG/workmind.git
WORKMIND_BRANCH=main
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── AI Providers ──────────────────────────────────────────────────────────────
# DeepSeek API (80% dei task: classificazione, entità, riassunti)
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Anthropic Claude API (15% dei task: analisi, report, validazione)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Mem0 AI Memory — 100% locale, usa DeepSeek come LLM + HuggingFace embeddings + Qdrant on-disk
# Nessuna API key necessaria: si configura automaticamente con DEEPSEEK_API_KEY

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# ── WhatsApp Business Cloud API ──────────────────────────────────────────────
# Token Meta Business API (da Meta Developer Console)
WHATSAPP_TOKEN=EAAG...your_token_here
# Phone Number ID (da WhatsApp Business settings)
WHATSAPP_PHONE_ID=123456789012345
# Token di verifica webhook (scegli una stringa qualsiasi)
WHATSAPP_VERIFY_TOKEN=workmind_verify_2024
# Webhook secret per firma HMAC (opzionale)
GITHUB_WEBHOOK_SECRET=

# Budget giornaliero per provider (USD, 0 = illimitato)
WORKMIND_DEEPSEEK_DAILY_LIMIT=5.00
WORKMIND_CLAUDE_DAILY_LIMIT=10.00

# ── Database gestionale ───────────────────────────────────────────────────────
# Password per l'utente read-only del database (host/porta/user in company.yaml)
WORKMIND_DB_PASSWORD=XXXXXXXXXX

# ── Email ─────────────────────────────────────────────────────────────────────
# Client secret Azure AD per Office 365 (tenant_id/client_id in company.yaml)
WORKMIND_EMAIL_SECRET=XXXXXXXXXX

# Password IMAP (se provider = imap in company.yaml)
WORKMIND_IMAP_PASSWORD=XXXXXXXXXX

# ── SMB / Cartelle condivise ──────────────────────────────────────────────────
WORKMIND_SMB_PASSWORD=XXXXXXXXXX

# ── RDP (Desktop Remoto) ──────────────────────────────────────────────────────
WORKMIND_RDP_PASSWORD=XXXXXXXXXX

# ── SMTP (per inviti utenti, reset password, notifiche email) ────────────────
SMTP_HOST=smtpa.aruba.it
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=smtp@faberweb.it
SMTP_PASS=sm2013tp
SMTP_FROM=smtp@faberweb.it

# ── Encryption at-rest ────────────────────────────────────────────────────────
# Master password per crittografia dati sensibili (min 16 caratteri)
WORKMIND_ENCRYPTION_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Redis (opzionale, fallback su in-memory se non raggiungibile) ─────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
