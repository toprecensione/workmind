# =============================================================================
# WorkMind — Environment Configuration Template
# CONFIDENTIAL - PRIVATE REPOSITORY - NOT FOR PUBLIC DISTRIBUTION
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ── Node Identity ─────────────────────────────────────────────────────────────
# Unique identifier for this Ubuntu node (e.g. node-001, node-milan-01)
WORKMIND_NODE_ID=node-001

# Human-readable label shown in reports and logs
WORKMIND_NODE_LABEL=Worker Node 1

# Deployment environment: production | staging | development
WORKMIND_ENV=production

# ── GitHub / Auto-Update ──────────────────────────────────────────────────────
# HTTPS URL of the private GitHub repository
WORKMIND_REPO_URL=https://github.com/YOUR_ORG/workmind.git

# Branch to track (usually main or production)
WORKMIND_BRANCH=main

# GitHub Personal Access Token with scope: Contents (read)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Logging ───────────────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
