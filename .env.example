# WorkMind 3 — Environment Variables
# Copy to .env and fill in values

# Core
WORKMIND_ENV=production
WORKMIND_PROFILE=start
WORKMIND_SECRET_KEY=change-me-to-a-64-char-random-string
NODE_ID=bender

# Database (asyncpg)
DATABASE_URL=postgresql+asyncpg://workmind:PASSWORD@localhost:5432/workmind_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434

# JWT
JWT_EXPIRE_MINUTES=1440

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Business (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Feature Flags
LOCAL_LLM=false
GPU_INFERENCE=false
MULTIORG=false
AUDIT_EXPORT=true
VECTOR_REINDEX=false
